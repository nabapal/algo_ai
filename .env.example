# Copy to .env for local use and replace every placeholder.
APP_USERNAME=
APP_PASSWORD=
APP_SESSION_SECRET=
APP_ENV=development
COOKIE_SECURE=false

FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=http://127.0.0.1:5050/auth/fyers/callback

AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
GEMINI_MODEL=gemini-flash-latest
CLAUDE_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-6-astra
PROXY_USERNAME=
PROXY_PASSWORD=

# Optional: point this to a persistent mounted directory on cloud hosts.
# DATA_DIR=/var/data
